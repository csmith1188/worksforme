<%- include('../../partials/header.ejs', {pageTitle: 'About' }); %>

    <link rel="stylesheet" href="/public/css/style.css">
    <link rel="stylesheet" href="/public/css/eventPage.css">

    <div class="mainContainer">
        <div class="content">
            <div class="tab-container">
                <div class="tab active" data-tab="main">Main Page</div>
                <div class="tab" data-tab="polls">Polls</div>
                <div class="tab" data-tab="message-board">Message Board</div>
                <div class="tab" data-tab="time">Time</div>
            </div>

            <div class="tab-content" id="main-tab" style="display: block;">
                <div id="popup-container">
                    <div id="popup">
                        <span id="popup-close-btn">&times;</span>
                        <center>
                            <h2 id="popup-title"></h2>
                            <div id="popup-content"></div>
                        </center>
                    </div>
                </div>

                <% if (isOwner) { %>
                    <div class="eventOptions">
                        <button class="inviteIcon" id="invite-button"></button>
                        <button class="editIcon" id="edit-button"></button>
                    </div>
                    <% } %>

                        <center>
                            <h1>
                                <%= event.name %>
                            </h1>
                            <p>
                                <%= event.description %>
                            </p>

                            <br>

                            <div id="calculated-date-container">
                                <h2 id="calculated-date-text"></h2>
                            </div>
                        </center>
            </div>

            <div class="tab-content" id="polls-tab" style="display: none;">
                <div id="polls-container">

                    <% if (isOwner) { %>
                        <button id="create-poll-btn">Create Poll</button>
                        <% } %>

                            <br> </br>

                            <% polls.forEach(poll=> { %>
                                <div class="poll" data-poll-id="<%= poll.poll_id %>">
                                    <h3>
                                        <%= poll.question %>
                                    </h3>
                                    <% poll.options.forEach(option=> { %>
                                        <button class="poll-option-btn" data-option-id="<%= option.option_id %>">
                                            <%= option.option_text %> (<%= option.votes %>)
                                        </button>
                                        <% }) %>
                                </div>
                                <% }) %>
                </div>
            </div>

            <div class="tab-content" id="message-board-tab" style="display: none;">
                <h2>Message Board</h2>
                <p>Coming soon...</p>
            </div>

            <div class="tab-content" id="time-tab" style="display: none;">
                <h2>Time Management</h2>
                <% if (isOwner) { %>
                    <div class="date-selection-container">
                        <label for="min-date">Min Date: </label>
                        <input type="date" id="min-date">
                        <label for="max-date">Max Date: </label>
                        <input type="date" id="max-date">
                        <br><br>
                        <label for="start-time">Start Time: </label>
                        <input type="time" id="start-time">
                        <label for="end-time">End Time: </label>
                        <input type="time" id="end-time">
                        <br><br>
                        <button id="calculate-date-btn">Calculate Optimal Date</button>
                    </div>

                    <% } %>
            </div>
        </div>
    </div>

    <script>
        const eventdata = JSON.parse('<%- JSON.stringify(event) %>');
        const eventID = '<%= event.uid %>';
    </script>
    <script src="/public/clientJS/dayjs.min.js"></script>
    <script src="/public/clientJS/util.js"></script>
    <script src="/public/clientJS/eventPage.js"></script>
    <script src="/public/clientJS/polling.js"></script>

    <%- include('../../partials/footer.ejs') %>